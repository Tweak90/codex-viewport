# Web host: replace reserved .example hostname with your Codex API host.
CODEX_WS_URL=ws://codex-host.example:4500
CODEX_API_TOKEN=
HOST_LABEL=KI-VM
CODEX_WEB_LANGUAGE=de
CODEX_SEND_WITH=shiftEnter
CODEX_FOLLOWUP_MODE=steer
CODEX_PROJECTS_ROOT=
# Optional release check without gh authentication on the Codex host.
CODEX_GITHUB_TOKEN=
# Optional repository override for forks, in owner/repo format.
CODEX_RELEASE_REPOSITORY=
# Optional image override for compose.image.yml.
# CODEX_WEB_IMAGE=ghcr.io/owner/codex-web-ui:latest
WEB_BIND_IP=0.0.0.0
WEB_PORT=8787

# Codex host: compose.gateway.yml settings; match paths and IDs to your host.
API_BIND_IP=0.0.0.0
API_PORT=4500
CODEX_SOCKET_DIR=${HOME}/.codex/app-server-control
CODEX_RUNTIME_SOCKET_DIR=/tmp/codex-daemon-1000
CODEX_UID=1000
CODEX_GID=1000
