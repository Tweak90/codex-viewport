# Web host: replace reserved .example hostname with your Codex API host.
CODEX_WS_URL=ws://codex-host.example:4500
CODEX_API_TOKEN=
HOST_LABEL=Codex-Host
CODEX_VIEWPORT_LANGUAGE=en
CODEX_SEND_WITH=shiftEnter
CODEX_FOLLOWUP_MODE=steer
CODEX_PROJECTS_ROOT=
# Optional token for private releases or a higher GitHub API request limit.
CODEX_GITHUB_TOKEN=
# Optional repository override for forks, in owner/repo format.
CODEX_RELEASE_REPOSITORY=
# Optional image override for compose.image.yml.
# CODEX_VIEWPORT_IMAGE=ghcr.io/owner/codex-viewport-ui:latest
WEB_BIND_IP=0.0.0.0
WEB_PORT=8787


# Persistent volume used by Compose; set an existing volume name when upgrading.
CODEX_VIEWPORT_VOLUME=codex-viewport-data
